{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "phoneticaid-v2",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  // runs the worker near the database (in Australia) rather than wherever a
  // request arrives, as some providers send Australian visitors to the US.
  // Named rather than "smart", which needs more traffic than this gets
  "placement": { "region": "aws:ap-southeast-2" },
  "main": "src/server.ts",
  "ai": {
    "binding": "AI",
    "remote": true,
  },
  // accounts (Better Auth) and synced projects
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "phoneticaid",
      "database_id": "51021dc0-62e2-4515-abe3-1d2fa0d708c9",
      "migrations_dir": "migrations",
    },
  ],
  // tells a user's other tabs and devices when a sync changed something
  // (see src/lib/sync/room.ts)
  "durable_objects": {
    "bindings": [{ "name": "SYNC_ROOM", "class_name": "SyncRoom" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SyncRoom"] }],
}
